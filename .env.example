PORT=3000

# Optional AI parser. Gemini is preferred when GEMINI_API_KEY is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional secondary AI parser. Used only when GEMINI_API_KEY is absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PARSER_DISABLED=false

# Optional Octavio forwarding.
OCTAVIO_API_BASE=https://octavio-poultry-farms.onrender.com
OCTAVIO_BATCH_ID=
OCTAVIO_TOKEN=

# Optional generic forwarding override.
BACKEND_TRANSACTION_URL=
